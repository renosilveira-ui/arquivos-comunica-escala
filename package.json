{
  "name": "escalas-hospitalares",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 npx expo start --web --port ${EXPO_PORT:-8081}",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --out-extension:.js=.mjs",
    "build:web": "expo export --platform web --output-dir web-build",
    "build:all": "pnpm build:web && pnpm build",
    "start": "NODE_ENV=production node dist/index.mjs",
    "check": "tsc --noEmit",
    "check:server": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:server",
    "lint": "expo lint",
    "format": "prettier --write .",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "security:audit": "node scripts/security/audit-dependencies.mjs",
    "security:lockfile": "node scripts/security/lockfile-osv-audit.mjs",
    "test": "vitest run",
    "test:sector-service-specialties-migration": "vitest run --config vitest.migration.config.ts",
    "test:readiness-fence-v1-mysql": "vitest run --config vitest.readiness-fence-v1-mysql.config.ts",
    "test:e2e": "cross-env NODE_ENV=test vitest run --config vitest.e2e-guard.config.ts",
    "e2e:workflow:destructive": "tsx scripts/run-e2e-workflow.ts",
    "gate": "pnpm test:e2e",
    "gate:destructive": "pnpm test:e2e && pnpm e2e:workflow:destructive",
    "db:push": "drizzle-kit push",
    "seed:staging": "tsx scripts/seed-staging.ts",
    "import:professionals": "tsx scripts/bulk-import-professionals.ts",
    "check:schedule-readiness": "tsx scripts/check-schedule-context-readiness.ts",
    "plan:sector-service-specialties": "tsx scripts/plan-sector-service-specialties.ts",
    "plan:unimed-hospital-provision": "tsx scripts/plan-unimed-hospital-provision.ts",
    "test:unimed-hospital-provision": "vitest run --config vitest.unimed-provision.config.ts",
    "provision:sao-carlos": "tsx scripts/provision-sao-carlos-contexts.ts",
    "provision:sala-recuperacao": "tsx scripts/provision-sala-recuperacao-schedule.ts",
    "provision:institution-scale": "tsx scripts/provision-institution-scale.ts",
    "normalize:corporate-structure": "tsx scripts/normalize-corporate-schedule-structure.ts",
    "apply:migration": "tsx scripts/apply-manual-migration.ts",
    "apply:readiness-fence-v1": "tsx scripts/apply-readiness-fence-v1-migration.ts",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "qr": "node scripts/generate_qr.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/elements": "^2.9.38",
    "@react-navigation/native": "^7.3.16",
    "@tanstack/query-async-storage-persister": "^5.102.1",
    "@tanstack/react-query": "^5.102.1",
    "@tanstack/react-query-persist-client": "^5.102.1",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/fontfaceobserver": "^2.1.3",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.0",
    "expo-blur": "^15.0.8",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.21",
    "expo-device": "^8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.11",
    "express": "^4.22.1",
    "express-rate-limit": "^8.6.2",
    "fontfaceobserver": "^2.3.0",
    "helmet": "^8.3.0",
    "jose": "6.2.9",
    "libphonenumber-js": "^1.13.12",
    "lucide-react-native": "^0.563.0",
    "mysql2": "^3.23.3",
    "nativewind": "^4.2.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^2.6.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "tar@>=7.0.0": "7.5.21",
      "undici@>=6.0.0 <7.0.0": "6.28.0",
      "ws@>=6.0.0 <7.0.0": "6.2.4",
      "ws@>=7.0.0 <8.0.0": "7.5.13",
      "ws@>=8.0.0 <9.0.0": "8.21.0",
      "node-forge@<1.4.0": "1.4.0",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "brace-expansion@>=1.0.0 <2.0.0": "1.1.18",
      "brace-expansion@>=4.0.0 <6.0.0": "5.0.9",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "path-to-regexp@<0.1.13": "0.1.13",
      "flatted@<3.4.2": "3.4.2",
      "vite@<6.4.3": "6.4.3",
      "browserslist": "4.28.7",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "nanoid@>=3.0.0 <4.0.0": "3.3.18",
      "@babel/core@<7.29.6": "7.29.6",
      "body-parser@>=1.0.0 <2.0.0": "1.20.6",
      "esbuild@<0.25.0": "0.25.0",
      "postcss@>=8.0.0 <8.5.23": "8.5.23",
      "postcss-selector-parser": "6.1.4",
      "@humanfs/node": "0.16.8",
      "qs@>=6.0.0 <6.16.0": "6.16.0",
      "@expo/ngrok@4.1.3>uuid": "11.1.1",
      "@expo/ngrok@4.1.3>yaml": "1.10.3",
      "xcode@3.0.1>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "decode-uri-component@0.2.2": "patches/decode-uri-component@0.2.2.patch",
      "image-size@1.2.1": "patches/image-size@1.2.1.patch"
    }
  }
}
