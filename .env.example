DATABASE_URL=mysql://root:root@127.0.0.1:3306/escalas_test
# DATABASE_SSL controls TLS to the MySQL server.
#   unset / "" / "false" / "disable" / "off"
#       → no TLS (local dev, tests, single-host).
#   "require"
#       → enable TLS, validate cert against system trust store
#         (production with publicly-signed certs).
#   "insecure"
#       → enable TLS, do NOT validate cert (acceptable staging fallback for
#         self-signed managed providers; never use in production).
DATABASE_SSL=
COOKIE_SECRET=changeme_min_32_chars_secret_here
# Suporte server ao exact-v1. Mantenha 0 até 100% das réplicas executarem o
# protocolo; em fase 1 pode virar 1 com clientes ainda em legacy.
SESSION_EXACT_BINDING_SUPPORTED=0
# Gate baked no bundle Expo/Web. Quando 1, o cliente exige preflight
# supported=true e pede exact-v1; não é uma variável dinâmica no cliente.
EXPO_PUBLIC_SESSION_EXACT_BINDING_CLIENT_ACTIVE=0
HOSPITAL_ALERT_URL=https://hospital-alert.example.com
HOSPITAL_ALERT_API_KEY=your_api_key_here
HOSPITAL_ALERT_ORG_ID=hsc
NODE_ENV=development
EXPO_PUBLIC_API_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,http://localhost:3001
COMUNICA_JWKS_URI=https://comunicamais-staging.onrender.com/.well-known/jwks.json
COMUNICA_ISSUER=https://comunicamais-staging.onrender.com
COMUNICA_AUDIENCE=escalas-app
COMUNICA_TENANT_MAP={"hsc":1,"sc":2}
SHIFT_RADAR_ENABLED=false
SHIFT_RADAR_POLL_MS=60000
SHIFT_RADAR_DEEPLINK_BASE_URL=exp://localhost:8081/--

# Comunica+ Integration
# Beta: fail-closed. Só use 1 após o Comunica+ aceitar dedupKey idempotente
# e a validação operacional descrita em docs/operations/scaling.md.
COMUNICA_PLUS_OUTBOUND_ENABLED=0
COMUNICA_PLUS_URL=https://comunicamais-staging.onrender.com
COMUNICA_PLUS_SYSTEM_EMAIL=system.escalas@hospital.com
COMUNICA_PLUS_SYSTEM_PASSWORD=changeme
COMUNICA_PLUS_SYSTEM_PIN=9999
EXPO_PUBLIC_HOSPITAL_ALERT_ENABLED=false

# SSO Escala → Comunica+
SSO_ISSUER=escalas-app
SSO_AUDIENCE=comunicamais
SSO_KID=escala-sso-staging-2026
SSO_KEYSTORE_PATH=
SSO_TARGET_URL=https://comunicamais-staging.onrender.com
SSO_ORG_MAP={"1":"uuid-da-org-comunicamais-aqui"}
# Em staging/prod: JSON com { publicJwk, privateJwk } (gerado em dev via .sso-keystore.json)
# SSO_PRIVATE_KEY_JWK=

# Chave privada RSA do SSO (JWK JSON). Em dev, vazio = gerada em .sso-keystore.json.
SSO_PRIVATE_KEY_JWK=

# E-mail transacional ("Esqueci minha senha"). Sem RESEND_API_KEY o link só é logado.
RESEND_API_KEY=
MAIL_FROM=Escala+ <no-reply@localhost>
APP_PUBLIC_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# Integrações externas (PRs 3-6). Todas OPCIONAIS: sem elas o app sobe normal,
# a agenda pessoal funciona e a escala não muda. Preencher pela metade é que
# bloqueia o boot em produção — ver server/_core/env-validation.ts.
# ---------------------------------------------------------------------------

# Criptografia em repouso das credenciais externas (refresh token do Google,
# origem de deslocamento). Mínimo 32 bytes. NUNCA reutilizar COOKIE_SECRET nem
# as chaves de AUTH_RECOVERY: o boot recusa segredo compartilhado entre
# domínios. Rotação: mover a atual para PREVIOUS, gerar nova, e só remover
# PREVIOUS depois que a varredura de rotação terminar.
EXTERNAL_CREDENTIALS_ENCRYPTION_KEY=
EXTERNAL_CREDENTIALS_ENCRYPTION_KID=v1
EXTERNAL_CREDENTIALS_ENCRYPTION_PREVIOUS_KEY=
EXTERNAL_CREDENTIALS_ENCRYPTION_PREVIOUS_KID=

# Google OAuth (Agenda). Client secret é server-side: nunca prefixar com
# EXPO_PUBLIC_, ou ele entra no bundle. Em produção o redirect precisa ser
# https, sem localhost e sem fragmento.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Google Maps Platform (Places + Routes). Chave server-side, restrita por API
# e por IP no Google Cloud. O app nunca a recebe.
GOOGLE_MAPS_API_KEY=

# Apple WeatherKit. A chave privada ES256 fica no servidor; o app nunca vê
# credencial da Apple. Cole o PEM com quebras de linha reais ou \n escapado.
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY=
